# ==fsdb core functions==
CORENAME core
COREDIR $FSDBDIR/fsdb-core
CORESCRIPTS $COREDIR/scripts
COREINSTALL $COREDIR/install
TEMPLATESDIR $COREINSTALL/templates
COREMACROS $CORESCRIPTS/Fiji.app/macros/fsdb.core/

# ==CORE INSTALLATION SCRIPTS ==
MICS_SETUP $COREINSTALL/defineMics.sh
EXPORTCONFIG $COREINSTALL/exportConfig.sh
IMPORTCONFIG $COREINSTALL/importConfig.sh
FSDB_INIT $COREINSTALL/initializeFsdb.sh
FSDB_SETUP $COREINSTALL/installFsdb.sh
ACCOUNTS_SETUP $COREINSTALL/makeAccounts.sh
BAT_SETUP $COREINSTALL/makeBat.sh
CRON_SETUP $COREINSTALL/setCron.sh
FIJI_SETUP $COREINSTALL/setupFiji.sh
SMB_SETUP $COREINSTALL/setupSmb.sh
BFT_SETUP $COREINSTALL/setupBioFormatsTools.sh

# ==CORE SCRIPTS==
MAKEINDEX $CORESCRIPTS/makeIndex.sh 
MAKEFSDBINIT $CORESCRIPTS/makeFsdbInit.sh	# <-- translates the label/value-pairs of scripts.config into ij.Prefs for use in fiji $COREDIR/makeFsdbInit.sh 
FIJIONSERVER $CORESCRIPTS/fijiOnServer.sh 
COMPLISTS $CORESCRIPTS/compareLists.sh		# <-- compares the fist column of two lists (files) $COREDIR/compareLists.sh  
UPDATEFSDB $CORESCRIPTS/updateFsdb.sh		# <-- updates the fsdb from online repo $COREDIR/updateFsdb.sh  
UPDATEMACROS $CORESCRIPTS/updateMacros.sh	# <-- updates fsdb-macros from import location to active location (FIJIDIR) $COREDIR/updateMacros.sh  
POPVARS_SCR $CORESCRIPTS/populateVarsInMacro.sh	# <-- populates/updates fsdb-variables within macros $COREDIR/populateVarsInMacro.sh  
POPVARS_FUN $CORESCRIPTS/getFsdbVars_fun.txt    # <-- transplantable function used by POPVARS_SCR $COREDIR/getFsdbVars_fun.txt      
CHECKPATH $CORESCRIPTS/checkFilePath.sh		# <-- eliminates incompatible filenames $COREDIR/checkFilePath.sh  
REMOVERAWDATA $CORESCRIPTS/removeRawDataFromFsdb.sh #TODO: deprecated?
FIXPERMISSIONS $CORESCRIPTS/fixPermissions.sh

# functional (helper) core macros
INITLOG_FMAC $COREMACROS/fsdb.core.initLOG.ijm
DEBUG_FMAC $COREMACROS/fsdb.core.logger.ijm
MAKEDIR_FMAC $COREMACROS/fsdb.core.makeDirRecursively.ijm
TIMESTAMP_FMAC $COREMACROS/fsdb.core.ts.ijm
DISSECTNAME_FMAC $COREMACROS/fsdb.core.dissectFilename.ijm
SAVEPNG_FMAC $SECDATAMACROS/fsdb.sdg.savePng.ijm 
# the following initially does not exist but is dynamically created by MAKEFSDBINIT
INITFSDB_FMAC $COREMACROS/fsdb.core.initFsdb.ijm

### == VARIABLES==
LEICA_FT lif
ZEISS_FT czi
NIKON_FT nd2
STACKEXTENSION nd2 lif	# <-- expandible list of treated file extension (currently possible values: nd2 czi lif) nd2 lif  
