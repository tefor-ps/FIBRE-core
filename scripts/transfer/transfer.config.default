# ==data transfer==
TRANSFERDIR $SCRIPTSDIR/transfer
AUTHDIR $SCRIPTSDIR/.auth

# ==data transfer==
MOUNTMICS $TRANSFERDIR/mountMicroscopes.sh
FETCHDATA $TRANSFERDIR/fetchDataFromMicroscopes.sh
MICS $AUTHDIR/.microscopes.sh

# ==cron settings==
# VARNAME_CRON m h dom mon dow user command
TRANSFER_CRON 13 5,19,23 * * * root ${FETCHDATA} save

